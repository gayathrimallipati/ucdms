DMS_URL=https://dms.jlr.local
# DMS_URL=https://stage.ucdms.in
DMS_EMAIL=dealer@cartrade.com
DMS_OTP=919919
# chrome | msedge | chromium   (leave empty to try chrome, then edge, then chromium)
DMS_BROWSER=
# 1 = no visible window
DMS_HEADLESS=0
# Lead ID to edit (PM12345). If empty, npm test asks in the terminal. Never uses the top grid row.
DMS_LEAD_ID=
# Folders with vehicle photos for Images-tab uploads (comma separated, jpg/png only).
# Leave empty to use tests/fixtures/vehicle-photos, then generated PNGs.
DMS_PHOTOS_DIR=
# Pause between image uploads, ms. Raise if stage returns HTTP 429 (too many requests).
DMS_UPLOAD_DELAY_MS=1200
# How long to wait out a 429 before continuing, ms.
DMS_RATE_LIMIT_WAIT_MS=60000
